# Vault Backend API — systemd Service Template
#
# This is a documented template for running the Vault FastAPI backend
# as a systemd service.  It is NOT auto-installed — copy it into place
# and adjust paths / env vars for your deployment.
#
# Installation:
#   sudo cp docs/operations/vault-backend.service.example /etc/systemd/system/vault-backend.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable vault-backend.service
#   sudo systemctl start vault-backend.service
#
# Restart after deploy:
#   sudo systemctl restart vault-backend.service
#
# See docs/operations/vault_release_runbook.md for full runbook.
#
# ⚠️ Paths below assume the repository lives at /root/vault-lms/repo.
#    Adjust WorkingDirectory and ExecStart if your layout differs.
# ⚠️ VAULT_OWNER_PASSWORD is set here as an example — use a systemd
#    EnvironmentFile or a secure credential store in production.

[Unit]
Description=Vault Backend API (FastAPI / uvicorn)
Documentation=https://github.com/trueinoking-lgtm/Vault
After=network.target surrealdb.service
Wants=network-online.target
Requires=surrealdb.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/vault-lms/repo

# Python runtime via uv
ExecStart=/root/vault-lms/repo/.venv/bin/uv run uvicorn api.main:app \
    --host 0.0.0.0 --port 5055

Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Environment — adjust per deployment
Environment=VAULT_OWNER_PASSWORD=change-me
Environment=VAULT_ENCRYPTION_KEY=change-me-too
Environment=SURREAL_URL=ws://127.0.0.1:8000/rpc
Environment=SURREAL_USER=root
Environment=SURREAL_PASSWORD=root
Environment=SURREAL_NAMESPACE=vault
Environment=SURREAL_DATABASE=vault

# Logging — everything goes to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vault-backend

# Security hardening
NoNewPrivileges=yes
ProtectHome=read-only
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
