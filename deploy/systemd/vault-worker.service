# Vault Background Worker — systemd Service Template
#
# Processes async jobs: source embedding, note embedding, insight embedding,
# podcast generation, and other background tasks.
# Without this worker, sources stay stuck at "CommandStatus.NEW" forever.
#
# Installation:
#   sudo cp deploy/systemd/vault-worker.service /etc/systemd/system/vault-worker.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable vault-worker.service
#   sudo systemctl start vault-worker.service
#
# Restart after deploy:
#   sudo systemctl restart vault-worker.service
#
# Status check:
#   sudo systemctl status vault-worker.service
#   sudo journalctl -u vault-worker.service -f
#
# See docs/operations/vault_release_runbook.md for full runbook.

[Unit]
Description=Vault Background Worker (surreal-commands)
Documentation=https://github.com/trueinoking-lgtm/Vault
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/vault-open-notebook

# Environment loaded from project .env (contains SurrealDB creds, FIREWORKS_API_KEY, etc.)
# systemd EnvironmentFile uses KEY=VALUE format — compatible with .env
EnvironmentFile=/root/vault-open-notebook/.env

# Python runtime via uv — imports commands module for job handlers
ExecStart=/usr/local/lib/hermes-agent/venv/bin/uv run \
    --env-file /root/vault-open-notebook/.env \
    surreal-commands-worker --import-modules commands

Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Logging — everything goes to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vault-worker

[Install]
WantedBy=multi-user.target
