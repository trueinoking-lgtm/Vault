# Vault Next.js Frontend — systemd Service
#
# Installation:
#   sudo cp deploy/systemd/vault-frontend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable vault-frontend.service
#   sudo systemctl start vault-frontend.service
#
# After building (deploy_vault_frontend_standalone.sh --restart-systemd
# calls this automatically):
#   sudo systemctl restart vault-frontend.service
#
# See docs/runbooks/vault_frontend_systemd.md for full runbook.

[Unit]
Description=Vault Next.js Frontend (standalone)
Documentation=https://github.com/trueinoking-lgtm/Vault
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/vault-vault/frontend

# Node.js runtime
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# Environment
Environment=NODE_ENV=production
Environment=PORT=3003
Environment=HOSTNAME=0.0.0.0

# Logging — everything goes to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vault-frontend

# Security hardening (optional; relax if Paths conflict with your setup)
NoNewPrivileges=yes
ProtectHome=read-only
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
